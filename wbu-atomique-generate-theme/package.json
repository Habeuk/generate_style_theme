{
  "name": "stan-compiler",
  "version": "1.0.0",
  "description": "module webpack pour la compilation de mes fichier",
  "main": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "Dev": "webpack --watch --node-env='development' --progress",
    "build": "--node-env=production webpack --watch --progress",
    "copy": "--node-env=production node scripts/build.js  --watch",
    "Prod": "webpack --node-env='production' --watch --progress",
    "ProdCMD": "./node_modules/.bin/webpack --node-env='production' ",
    "DevCMD": "./node_modules/.bin/webpack --node-env='development' ",
    "serve": "webpack serve --mode='production' --open"
  },
