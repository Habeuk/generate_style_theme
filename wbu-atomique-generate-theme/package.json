    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.22.0",
    "eslint-webpack-plugin": "^5.0.0",
    "globals": "^16.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss": "^8.5.3",
